# Dockerfile para produção - Multi-stage build
# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# Stage 2: Servir com nginx
FROM nginx:alpine

# Copia os arquivos buildados para o nginx
COPY --from=builder /app/dist/front-comanda/browser /usr/share/nginx/html

# Configuração do nginx para SPA
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
